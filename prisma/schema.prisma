// Note: For MongoDB, Prisma supports it but recommend Mongoose since deps include it.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Product {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  description        String
  image              String
  category           String   @default("small")
  length             Float
  width              Float
  height             Float
  basePrice          Float
  bulkDiscountTiers  String   @default("[]")
  inStock            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Contact {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

